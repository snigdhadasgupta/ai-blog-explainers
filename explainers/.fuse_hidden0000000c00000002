     style="background:#2A2880;color:#fff;text-decoration:none;font-size:12px;font-weight:700;padding:9px 13px;border-radius:100px;box-shadow:0 6px 18px -8px rgba(0,0,0,.5);text-align:center;">Read original &#8599;</a>
  <button onclick="aibeCopy()" title="Copy link"
     style="background:#3D3AAE;color:#fff;border:none;cursor:pointer;font-size:12px;font-weight:700;padding:9px 13px;border-radius:100px;box-shadow:0 6px 18px -8px rgba(0,0,0,.5);">Copy link</button>
  <div style="display:flex;gap:8px;">
    <a id="aibe-li" target="_blank" rel="noopener" title="Share on LinkedIn"
       style="flex:1;background:#0A66C2;color:#fff;text-decoration:none;font-size:12px;font-weight:700;padding:9px 0;border-radius:100px;text-align:center;box-shadow:0 6px 18px -8px rgba(0,0,0,.5);">in</a>
    <a id="aibe-x" target="_blank" rel="noopener" title="Share on X"
       style="flex:1;background:#1F1B18;color:#fff;text-decoration:none;font-size:12px;font-weight:700;padding:9px 0;border-radius:100px;text-align:center;box-shadow:0 6px 18px -8px rgba(0,0,0,.5);">X</a>
  </div>
</div>
<script>
(function(){
  var u=encodeURIComponent(location.href), t=encodeURIComponent(document.title.replace(" — Explainer",""));
  document.getElementById("aibe-li").href="https://www.linkedin.com/sharing/share-offsite/?url="+u;
  document.getElementById("aibe-x").href="https://twitter.com/intent/tweet?url="+u+"&text="+t;
})();
function aibeCopy(){
  navigator.clipboard.writeText(location.href).then(function(){
    var b=event.target; var o=b.textContent; b.textContent="Copied!"; setTimeout(function(){b.textContent=o;},1400);
  });
}
</script>
<script>
(function(){
  var ORDER={tldr:0,manager:1,tech:2};
  var HINT={
    tldr:"Just the five-line summary + the takeaway.",
    manager:"Summary, why it matters, and what to do — no deep internals.",
    tech:"Everything, including the identity chain and program-level changes."
  };
  var btns=[].slice.call(document.querySelectorAll('#aibe-depth button'));
  var hintEl=document.getElementById('aibe-depthhint');
  function apply(lvl){
    var max=ORDER[lvl]; if(max===undefined){lvl='manager';max=1;}
    document.querySelectorAll('section[data-depth]').forEach(function(sec){
      var t=ORDER[sec.getAttribute('data-depth')];
      sec.style.display=(t<=max)?'':'none';
    });
    btns.forEach(function(b){b.classList.toggle('on',b.getAttribute('data-lvl')===lvl);});
    if(hintEl) hintEl.textContent=HINT[lvl]||'';
    try{localStorage.setItem('aibe-depth',lvl);}catch(e){}
  }
  btns.forEach(function(b){b.addEventListener('click',function(){apply(b.getAttribute('data-lvl'));});});
  var saved='manager';
  try{var v=localStorage.getItem('aibe-depth'); if(v&&ORDER[v]!==undefined)saved=v;}catch(e){}
  apply(saved);
})();
</script>
</body>
</html>
